/-- Integer numerator of the candidate Gram matrix's cyclic coefficient. -/
def aesSboxCyclicGramNumerator (k : Fin 255) : Int :=
  aesSboxCyclicGramNumerators[k.val]?.getD 0

/-- The candidate Gram matrix's cyclic coefficient on nonzero differences. -/
def aesSboxCyclicGramCoefficient (k : Fin 255) : ℚ :=
  (aesSboxCyclicGramNumerator k : ℚ) / 65280 ^ 2

/-- A rational cyclic factor, rounded to a denominator of `10^8`. -/
def aesSboxCyclicFactorCoefficient (k : Fin 255) : ℚ :=
  (aesSboxCyclicFactorNumerators[k.val]?.getD 0 : ℚ) / 100000000

